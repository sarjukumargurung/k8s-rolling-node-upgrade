# Copy to config/upgrade.env and edit.
# TARGET_VERSION is the kubeadm/kubelet package stream, without a leading "v".
TARGET_VERSION=1.36.1

# Worker selection. Control-plane nodes are always skipped.
NODE_LABEL_SELECTOR='!node-role.kubernetes.io/control-plane,!node-role.kubernetes.io/master'
# Optional extra excludes (space-separated node names)
EXCLUDE_NODES=""

GRACE_PERIOD=60
DRAIN_TIMEOUT=10m
READY_TIMEOUT=5m
SOAK_SECONDS=30

# Minimum Ready worker nodes that must remain schedulable while one node is drained
MIN_READY_WORKERS=1

# Remote upgrade
SSH_USER=ubuntu
SSH_OPTS="-o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 -o ServerAliveInterval=15"
PACKAGE_FAMILY=debian   # debian | rhel

# Safety
REQUIRE_CONFIRMATION=true
CONTINUE_ON_NODE_FAILURE=false
